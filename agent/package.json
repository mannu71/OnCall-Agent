{
    "name": "oncall-agent",
    "version": "1.0.0",
    "description": "Oncall workflow automation agent with scheduler and executor",
    "main": "src/worker.js",
    "type": "module",
    "scripts": {
        "start": "node src/scheduler/index.js & node src/worker/index.js",
        "start:scheduler": "node src/scheduler/index.js",
        "start:worker": "node src/worker/index.js",
        "dev": "node --watch src/scheduler/index.js & node --watch src/worker/index.js",
        "test": "node --test tests/**/*.test.js"
    },
    "keywords": [
        "workflow",
        "orchestrator",
        "scheduler",
        "mcp",
        "automation"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.4",
        "chokidar": "^4.0.3",
        "cron-parser": "^5.4.0",
        "js-yaml": "^4.1.1",
        "pgsql-ast-parser": "^12.0.1",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.2"
    }
}
