"""Workflow storage service using YAML files."""
import os
import yaml
from datetime import datetime
from typing import Dict, List, Optional
from pathlib import Path

from app.models.workflow import Workflow, WorkflowExecution
from app.config import settings


class WorkflowStorage:
    """Manages workflow persistence using YAML files."""

    def __init__(self, storage_path: Optional[str] = None):
        """Initialize storage with the given path."""
        self.storage_path = Path(storage_path or settings.storage_path)
        self.workflows_path = self.storage_path / "workflows"
        self.logs_path = self.storage_path / "logs"
        
        # Create storage directories
        self.workflows_path.mkdir(parents=True, exist_ok=True)
        self.logs_path.mkdir(parents=True, exist_ok=True)

    def _workflow_file_path(self, workflow_name: str) -> Path:
        """Get the file path for a workflow."""
        return self.workflows_path / f"{workflow_name}.yaml"

    def _execution_log_path(self, workflow_name: str, execution_id: str) -> Path:
        """Get the log file path for an execution."""
        workflow_log_dir = self.logs_path / workflow_name
        workflow_log_dir.mkdir(parents=True, exist_ok=True)
        return workflow_log_dir / f"{execution_id}.yaml"

    def save_workflow(self, workflow: Workflow) -> None:
        """Save a workflow to disk."""
        file_path = self._workflow_file_path(workflow.name)
        
        # Add metadata
        workflow_data = workflow.dict()
        workflow_data['updated_at'] = datetime.utcnow().isoformat()
        
        # Create if doesn't exist
        if not file_path.exists():
            workflow_data['created_at'] = workflow_data['updated_at']
        else:
            # Preserve created_at
            existing = self.load_workflow(workflow.name)
            if existing and hasattr(existing, 'created_at'):
                workflow_data['created_at'] = existing.created_at.isoformat() if existing.created_at else workflow_data['updated_at']
        
        with open(file_path, 'w') as f:
            yaml.safe_dump(workflow_data, f, default_flow_style=False, sort_keys=False)

    def load_workflow(self, workflow_name: str) -> Optional[Workflow]:
        """Load a workflow from disk."""
        file_path = self._workflow_file_path(workflow_name)
        
        if not file_path.exists():
            return None
        
        with open(file_path, 'r') as f:
            data = yaml.safe_load(f)
        
        # Remove metadata fields before validation
        created_at = data.pop('created_at', None)
        updated_at = data.pop('updated_at', None)
        
        workflow = Workflow(**data)
        
        # Add metadata back
        if created_at:
            workflow.created_at = datetime.fromisoformat(created_at) if isinstance(created_at, str) else created_at
        if updated_at:
            workflow.updated_at = datetime.fromisoformat(updated_at) if isinstance(updated_at, str) else updated_at
        
        return workflow

    def delete_workflow(self, workflow_name: str) -> bool:
        """Delete a workflow from disk."""
        file_path = self._workflow_file_path(workflow_name)
        
        if not file_path.exists():
            return False
        
        file_path.unlink()
        return True

    def list_workflows(self) -> List[Workflow]:
        """List all workflows."""
        workflows = []
        
        for file_path in self.workflows_path.glob("*.yaml"):
            workflow_name = file_path.stem
            workflow = self.load_workflow(workflow_name)
            if workflow:
                workflows.append(workflow)
        
        return workflows

    def workflow_exists(self, workflow_name: str) -> bool:
        """Check if a workflow exists."""
        return self._workflow_file_path(workflow_name).exists()

    def save_execution_log(self, execution: WorkflowExecution) -> None:
        """Save an execution log to disk."""
        log_path = self._execution_log_path(execution.workflow_name, execution.execution_id)
        
        with open(log_path, 'w') as f:
            yaml.safe_dump(execution.dict(), f, default_flow_style=False, sort_keys=False)

    def load_execution_log(self, workflow_name: str, execution_id: str) -> Optional[WorkflowExecution]:
        """Load an execution log from disk."""
        log_path = self._execution_log_path(workflow_name, execution_id)
        
        if not log_path.exists():
            return None
        
        with open(log_path, 'r') as f:
            data = yaml.safe_load(f)
        
        return WorkflowExecution(**data)

    def list_execution_logs(self, workflow_name: str, limit: int = 50) -> List[WorkflowExecution]:
        """List execution logs for a workflow."""
        workflow_log_dir = self.logs_path / workflow_name
        
        if not workflow_log_dir.exists():
            return []
        
        executions = []
        log_files = sorted(workflow_log_dir.glob("*.yaml"), key=lambda x: x.stat().st_mtime, reverse=True)
        
        for log_file in log_files[:limit]:
            execution_id = log_file.stem
            execution = self.load_execution_log(workflow_name, execution_id)
            if execution:
                executions.append(execution)
        
        return executions

    def get_workflow_metadata(self, workflow_name: str) -> Optional[Dict]:
        """Get workflow metadata (created_at, updated_at)."""
        file_path = self._workflow_file_path(workflow_name)
        
        if not file_path.exists():
            return None
        
        with open(file_path, 'r') as f:
            data = yaml.safe_load(f)
        
        return {
            'created_at': data.get('created_at'),
            'updated_at': data.get('updated_at'),
        }


# Global storage instance
workflow_storage = WorkflowStorage()
