# Copy to .env (setup.sh / setup.ps1 does this for you) and adjust as needed.

# Database (host port matches the docker-compose postgres mapping, 45432)
DATABASE_URL=postgresql://kycuser:kycpassword@localhost:45432/kycagent

# LLM provider: anthropic | bedrock | openai
PROVIDER_TRANSPORT=bedrock
AWS_REGION=eu-west-1
AWS_PROFILE=

# Local data directories (created automatically on first run)
STORAGE_PATH=data/storage
WORKFLOW_DIR=data/workflows
LOGS_DIR=data/logs

# Code analyzer — parent folder containing sibling repositories to index.
# setup substitutes this with the folder that contains this repo.
REPOS_BASE_PATH=__REPOS_PATH__

# Docker-only: host path for the code analyzer volume mount (same folder as REPOS_BASE_PATH)
REPOS_HOST_PATH=__REPOS_PATH__

# Logging
LOG_LEVEL=INFO
