# Copy to .env and adjust before running `docker compose up --build -d`

# Host path to your local code repositories (mounted read-write for the edit_file tool).
# Linux/Mac: REPOS_HOST_PATH=/home/yourname/source/repos
# Windows:   REPOS_HOST_PATH=C:/Users/yourname/source/repos
REPOS_HOST_PATH=./agent-api/data/indexed_repos

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
