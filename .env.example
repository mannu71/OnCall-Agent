# Copy to .env and adjust before running `docker compose up --build -d`

# Host path to your local code repositories (mounted read-write for the edit_file tool).
# Linux/Mac: REPOS_HOST_PATH=/home/yourname/source/repos
# Windows:   REPOS_HOST_PATH=C:/Users/yourname/source/repos
REPOS_HOST_PATH=./agent-api/data/indexed_repos

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Host ports ───────────────────────────────────────────────────────────────
# The stack publishes on uncommon ports so it doesn't clash with anything already
# running on your machine. Only uncomment/change these if a default is taken —
# the container-internal ports never change.
#   UI:         http://localhost:43000
#   API:        http://localhost:48000
#   Postgres:   localhost:45432
#   headroom:   127.0.0.1:48787 (loopback only)
# POSTGRES_HOST_PORT=45432
# API_HOST_PORT=48000
# UI_HOST_PORT=43000
# HEADROOM_HOST_PORT=48787

# ── Corporate proxy (build time) ─────────────────────────────────────────────
# Only needed if the Docker build can't reach the npm/pip registries directly
# (e.g. an SSL-inspecting corporate proxy). Docker Desktop's own proxy settings
# under Settings → Resources → Proxies also work. Leave blank otherwise.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
# NPM_REGISTRY=https://your-internal-mirror/npm/

# ── Corporate proxy (run time) ───────────────────────────────────────────────
# Path on the HOST to your SSL-inspecting proxy's CA bundle (e.g. Netskope).
# When set, it's mounted into the agent-api container and wired into
# AWS_CA_BUNDLE / REQUESTS_CA_BUNDLE / SSL_CERT_FILE / NODE_EXTRA_CA_CERTS so
# the CloudWatch MCP subprocess (and all boto3/requests/node calls) trust the
# re-signed chain. Leave unset on machines without an inspecting proxy.
# NETSKOPE_CERT_PATH=C:/Windows/Certificates/CombinedNetskopeCert.pem
