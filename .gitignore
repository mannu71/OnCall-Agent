# Dependencies
node_modules/
*/node_modules/
**/node_modules/
# NOTE: package-lock.json MUST be committed — the UI Docker build runs
# `npm ci`, which requires an in-sync lockfile in the repo. Ignoring it broke
# the image build on every machine except ones with a stale local lockfile.

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Python virtual environment
.venv/
venv/
env/

# Claude
.claude/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Build artifacts
dist/
build/
*.pyc
__pycache__/

# Test coverage
coverage/
.nyc_output/
.pytest_cache/
.ruff_cache/
.hypothesis/

# Runtime config (generated via the ADO settings UI, not source)
agent-api/config/azure_devops_credentials.json

# Output and runtime files
output/
agent/output/
agent/logs/
scheduler/triggers/*.flag
worker/output/

# Ignore entire data directories
agent/data/
agent-api/data/

# Code graph
# codegraph/

# Temporary files
tmp/
temp/
*.tmp
